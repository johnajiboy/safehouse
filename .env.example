ANTHROPIC_API_KEY=your-key-here
# Optional: change the model used to read reports
SAFEHOME_MODEL=claude-sonnet-5-5
# Demo mode adds a passwordless "Continue as demo officer" sign-in. Keep false for real data.
DEMO_MODE=false
# First officer account, created when the app starts if no officer accounts exist yet.
# Use your own values in .env; the password is stored hashed, never as plain text.
OFFICER_USERNAME=
OFFICER_PASSWORD=
